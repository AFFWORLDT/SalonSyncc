<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode switches this to "production" when archiving with a distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- One-tap sign-in and invite links (https://<salon>.salonkit.online/l/…) open the app: Universal Links. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:*.salonkit.online</string>
		<string>applinks:salonkit.online</string>
	</array>
</dict>
</plist>
