<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the SalonKit icon on cream, then the splash art on the same cream. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_cream</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_cream</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_cream</item>
    </style>
</resources>
