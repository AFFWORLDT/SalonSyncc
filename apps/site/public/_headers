# Security headers for every page and file of the web app (Cloudflare static assets read this file).
# - No other site may show the app in a frame (clickjacking).
# - Links to other sites send only our origin, never the page address (receipt/rating links carry a token).
# - The browser must not guess file types; no camera/mic/location/payment access is ever needed.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Build files have a content hash in their name: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images, video and brand files change rarely: a week, then revalidate.
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
