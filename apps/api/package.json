{
  "name": "@ss/api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --var ROOT_DOMAIN:",
    "db:migrate:local": "wrangler d1 migrations apply salonkit-db --local",
    "db:seed:local": "wrangler d1 execute salonkit-db --local --file scripts/seed-local.sql",
    "db:gen-seed": "node --experimental-strip-types scripts/gen-plan-seed.ts > migrations/0003_seed_plans.sql"
  },
  "dependencies": {
    "@ss/contract": "*",
    "@ss/features": "*",
    "hono": "^4.13.13",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.1"
  }
}
