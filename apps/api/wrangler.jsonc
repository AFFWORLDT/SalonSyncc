{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salonkit-app",
  // Affworld0@gmail.com's Cloudflare account. Never deploy this to any other account.
  "account_id": "dd501fac7d8aa896ead9530b9cd1b913",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "workers_dev": true,
  // Every salon gets <slug>.salonkit.online (and admin.salonkit.online for the super admin). The apex is left for the
  // marketing site (Plan 4). Needs a proxied wildcard DNS record "*" in the salonkit.online zone (AAAA 100::).
  // salonkit.online/api/* (more specific than the site Worker's salonkit.online/*) lets the marketing site post signups
  // same-origin.
  "routes": [
    { "pattern": "*.salonkit.online/*", "zone_name": "salonkit.online" },
    { "pattern": "salonkit.online/api/*", "zone_name": "salonkit.online" },
    { "pattern": "www.salonkit.online/api/*", "zone_name": "salonkit.online" }
  ],
  // The salon dashboard (apps/web static export), same origin as the API. Build it first: npm run build -w @ss/web.
  "assets": { "directory": "../web/out", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/*", "!/_next/*"] },
  // The cron (src/jobs/hourly.ts): every 10 minutes, each tick within the free plan's per-invocation limits.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "BRAND_NAME": "SalonKit", "ROOT_DOMAIN": "salonkit.online", "ADMIN_HOST": "admin", "MAIL_FROM": "SalonKit <hello@salonkit.online>", "SUPPORT_EMAIL": "", "APP_ORIGIN": "https://salonkit-app.affworld0.workers.dev" },
  // Secrets (wrangler secret put): SESSION_SECRET, SECRETS_KEY (base64 32 bytes), FCM_SERVICE_ACCOUNT, WA_APP_SECRET, WA_VERIFY_TOKEN.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salonkit-db",
      "database_id": "ea41ae98-4ed9-4e15-ba57-6804d0771d80",
      "migrations_dir": "migrations"
    }
  ]
}
